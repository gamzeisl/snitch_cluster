{
    setup_ssr: 1,
    parallelize_m: 0,
    parallelize_k: 0,
    m_tiles: 1, // number of tiles in M dimension
    n_tiles: 1, // number of tiles in N dimension
    k_tiles: 1, // number of tiles in K dimension
    load_a: 1,
    load_b: 1,
    load_c: 1,
    transa: false,
    transb: true, // must be true for SIMD
    M: 32,
    N: 32,
    K: 32,
    block_size: 32,
    alpha: 1,
    beta: 0,
    gemm_fp: "mxgemm_fp8_fp32_baseline",
    src_type: "FP8",
    dst_type: "FP32"
}
